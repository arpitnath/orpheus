{
  "name": "orpheus-cli",
  "version": "0.1.0",
  "description": "Orpheus CLI - Infrastructure for AI agents",
  "type": "module",
  "bin": {
    "orpheus": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "agents",
    "ai",
    "infrastructure"
  ],
  "author": "Orpheus",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "ink": "^5.0.1",
    "react": "^18.2.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

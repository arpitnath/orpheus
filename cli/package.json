{
  "name": "orpheus-cli",
  "version": "0.1.4",
  "description": "Orpheus CLI - The runtime for AI agents",
  "type": "module",
  "bin": {
    "orpheus": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:built": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cli",
    "agents",
    "ai",
    "infrastructure",
    "runtime",
    "autoscaling",
    "containers",
    "llm"
  ],
  "author": "Orpheus Systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arpitnath/orpheus.git",
    "directory": "cli"
  },
  "homepage": "https://orpheus.run",
  "bugs": {
    "url": "https://github.com/arpitnath/orpheus/issues"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.2.0",
    "tar": "^7.5.2",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
